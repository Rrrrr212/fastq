+++ b/services/logQueue.js
@@ -0,0 +1,45 @@
+'use strict'
+
+const fs = require('fs')
+const path = require('path')
+const fastq = require('../queue.js')
+
+const LOG_FILE = path.join(__dirname, '..', 'logs', 'app.log')
+
+// 确保 logs 目录存在
+const logDir = path.dirname(LOG_FILE)
+if (!fs.existsSync(logDir)) {
+  fs.mkdirSync(logDir, { recursive: true })
+}
+
+// 创建并发数为 3 的 fastq 任务队列
+const queue = fastq(worker, 3)
+
+// worker 函数：将日志追加写入文件
+function worker (message, cb) {
+  const startTime = Date.now()
+  
+  fs.appendFile(LOG_FILE, message + '\n', (err) => {
+    const duration = Date.now() - startTime
+    if (err) {
+      console.error(`[logQueue] 写入日志失败: ${err.message}`)
+      return cb(err)
+    }
+    console.log(`[logQueue] 日志写入完成，耗时: ${duration}ms`)
+    cb(null)
+  })
+}
+
+/**
+ * 推送日志消息到队列
+ * @param {string} message - 要写入的日志消息
+ */
+function pushLog (message) {
+  queue.push(message, (err) => {
+    if (err) {
+      console.error(`[logQueue] 任务执行失败: ${err.message}`)
+    }
+  })
+}
+
+module.exports = { pushLog }
