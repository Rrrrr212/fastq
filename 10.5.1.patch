-const queue = fastq(worker, 3)
+const { logQueue: logQueueConfig } = require('../config/queueConfig')
+
+const DEFAULT_CONCURRENCY = logQueueConfig.baseConcurrency
+const BURST_CONCURRENCY = logQueueConfig.burstConcurrency
+const SCALE_UP_THRESHOLD = logQueueConfig.scaleUpThreshold
+const SCALE_DOWN_THRESHOLD = logQueueConfig.scaleDownThreshold
+
+const queue = fastq(worker, DEFAULT_CONCURRENCY)
+
+function syncConcurrency () {
+  const pendingCount = queue.length()
+
+  if (pendingCount > SCALE_UP_THRESHOLD && queue.concurrency !== BURST_CONCURRENCY) {
+    queue.concurrency = BURST_CONCURRENCY
+    return
+  }
+
+  if (pendingCount < SCALE_DOWN_THRESHOLD && queue.concurrency !== DEFAULT_CONCURRENCY) {
+    queue.concurrency = DEFAULT_CONCURRENCY
+  }
+}
+
+function wrapDone (done) {
+  return function onDone (err, result) {
+    syncConcurrency()
+    if (typeof done === 'function') {
+      done(err, result)
+    }
+  }
+}
@@
-function pushLog (payload, done) {
-  return queue.push(payload, done)
+function pushLog (payload, done) {
+  const task = queue.push(payload, wrapDone(done))
+  syncConcurrency()
+  return task
 }
